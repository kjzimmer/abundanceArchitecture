# Port the Express server listens on. Railway injects its own PORT at
# runtime; this default is only used for local development.
PORT=3000

# development | production
NODE_ENV=development

# PostgreSQL connection string.
# Local: postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Production: copy the DATABASE_URL from the Railway Postgres service
# (Railway dashboard → Postgres service → Variables tab), then add it
# as a Variable Reference in the app service's Variables panel.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/abundance_architecture_dev"

# Secret key for signing JWT tokens. Use a long random string (32+ chars).
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# See docs/wip/email-newsletter.md.
# EMAIL_MODE: live = send via Resend | log = print to console only (default) |
#             redirect = send via Resend but deliver everything to EMAIL_REDIRECT_TO
# Production must set EMAIL_MODE=live. Leave unset locally unless testing real delivery.
EMAIL_MODE=
EMAIL_REDIRECT_TO=
# Resend → API Keys → "aa-app" (Sending access, scoped to abundancearchitecture.world)
RESEND_API_KEY=
# Resend → Webhooks → endpoint https://abundancearchitecture.world/api/webhooks/resend → signing secret
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Abundance Architecture <hello@abundancearchitecture.world>"
# Sender for admin notices — separate from EMAIL_FROM so notice reputation/filtering is isolated
EMAIL_NOTIFY_FROM="Abundance Architecture <notify@abundancearchitecture.world>"
# Receives [AA Inquiry], [AA Subscriber], [AA Unsubscribe], [AA Deliverability] notices
ADMIN_NOTIFY_EMAIL=
# Base for links in emails (confirm / unsubscribe). Local default: http://localhost:$PORT
PUBLIC_BASE_URL=https://abundancearchitecture.world

# ─── Cloudflare Turnstile (bot check on subscribe + contact) ──────────────────
# Cloudflare → Turnstile → Add widget (hostname: abundancearchitecture.world, mode: Managed)
# If TURNSTILE_SECRET_KEY is unset, verification is skipped (local dev).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Analytics (optional — enables the Analytics tab in admin).
# CF_ANALYTICS_TOKEN: Cloudflare → My Profile → API Tokens
#   Use "Read analytics for a zone" template, scoped to this domain only.
# CF_ZONE_ID and CF_ACCOUNT_ID: Cloudflare dashboard → domain overview → right sidebar.
CF_ANALYTICS_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=

# Optional: enables top pages / referrers / device type data in analytics.
# Generate at Cloudflare Dashboard → Web Analytics → Add a site.
CF_WEB_ANALYTICS_SITE_TAG=
